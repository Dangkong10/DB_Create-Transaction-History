# =============================================================================
# 환경변수 템플릿 (이 파일은 git에 커밋됨 — 실제 키는 절대 넣지 말 것)
# =============================================================================
#
# 로컬 개발 → .env.local 에 dev Supabase 키 입력 (gitignore됨, 우선순위 높음)
# 프로덕션  → Vercel Dashboard → Settings → Environment Variables 에 prod 키 입력
#
# 우선순위 (높음 → 낮음):
#   1. 시스템 환경변수 / Vercel Env Vars
#   2. .env.local  ← 로컬 dev 키 (당신이 만들 파일)
#   3. .env        ← 폴백 (로컬에서는 비워두거나 dev 키 복사본)
# =============================================================================

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
